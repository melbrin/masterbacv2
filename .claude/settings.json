{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run verif)",
      "Bash(npm run verif *)",
      "Bash(npm run lint)",
      "Bash(npm run lint *)",
      "Bash(npm run typecheck)",
      "Bash(npm run test)",
      "Bash(npm run test *)",
      "Bash(npm run test:db)",
      "Bash(npm run test:db *)",
      "Bash(npm run test:integration)",
      "Bash(npm run test:integration *)",
      "Bash(npm run test:e2e)",
      "Bash(npm run test:e2e *)",
      "Bash(npm run test:securite)",
      "Bash(npm run test:securite *)",
      "Bash(npm run tout)",
      "Bash(npm run build)",
      "Bash(npm run contenu:verifier)",
      "Bash(npm run env:verifier)",
      "Bash(npm run db:demarrer)",
      "Bash(npm run db:arreter)",
      "Bash(npm run db:reinitialiser)",
      "Bash(npm run db:types)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(gh pr merge *)",
      "Bash(gh secret *)",
      "Bash(gh workflow run *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm uninstall *)",
      "Bash(npm update *)",
      "Bash(npm run distant:*)",
      "Bash(supabase link *)",
      "Bash(npx supabase link *)",
      "Bash(supabase db push *)",
      "Bash(npx supabase db push *)",
      "Bash(supabase db push)",
      "Bash(npx supabase db push)",
      "Bash(supabase migration repair *)",
      "Bash(npx supabase migration repair *)",
      "Bash(supabase config push *)",
      "Bash(npx supabase config push *)",
      "Bash(supabase secrets *)",
      "Bash(npx supabase secrets *)",
      "Bash(vercel *)",
      "Bash(npx vercel *)",
      "Bash(stripe *)",
      "Bash(npx stripe *)",
      "Edit(./.github/workflows/**)",
      "Edit(./.claude/settings.json)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * --force-with-lease)",
      "Bash(git push * --force-with-lease *)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push origin HEAD:main *)",
      "Bash(supabase db reset --linked)",
      "Bash(supabase db reset --linked *)",
      "Bash(npx supabase db reset --linked)",
      "Bash(npx supabase db reset --linked *)",
      "Bash(supabase projects delete *)",
      "Bash(npx supabase projects delete *)",
      "Bash(vercel remove *)",
      "Bash(vercel rm *)",
      "Bash(npx vercel remove *)",
      "Bash(npx vercel rm *)",
      "Bash(npm publish)",
      "Bash(npm publish *)"
    ]
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true
  }
}
