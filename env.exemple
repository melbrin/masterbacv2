# Modèle des variables d'environnement de l'application MasterBac.
# Ce fichier ne contient que des noms. Les valeurs vont dans .env.local (ordinateur de Yane),
# dans les réglages de Vercel et dans les secrets de GitHub Actions. Voir docs/06-comptes-et-secrets.md.
# En local : `npm run env:local` prépare .env.local, `npm run env:verifier` dit ce qui manque.

# --- Application ---
APP_ENV=                      # local, recette ou production
APP_URL=                      # adresse de l'application, pour les liens des e-mails

# --- Supabase ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=     # utilisée par le serveur au nom de la personne connectée ; jamais envoyée au navigateur
SUPABASE_SECRET_KEY=          # secret : tous les droits sur la base

# --- Stripe ---
STRIPE_SECRET_KEY=            # secret : clé restreinte de l'application
STRIPE_WEBHOOK_SECRET=        # secret : signature des messages
STRIPE_PRICE_PASS=
STRIPE_PRICE_PASS_CLIENT=
STRIPE_PRICE_MENSUEL=
STRIPE_PRICE_STAGE=
STRIPE_PRICE_PACK=
STRIPE_COUPON_STAGE=

# --- E-mails ---
RESEND_API_KEY=               # secret
EMAIL_FROM=                   # adresse d'envoi, sur le sous-domaine réservé aux e-mails
EMAIL_REPLY_TO=               # adresse de réponse, lue par Yane

# --- Tâches planifiées et empreintes ---
CRON_SECRET=                  # secret : protège les routes des tâches planifiées
HASH_PEPPER=                  # secret : sert à calculer les empreintes (adresses des clients actuels, adresses IP)

# --- Test anti-robot (ouverture publique) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=         # secret

# --- Correction sur photo (phase 5) ---
AI_API_KEY=                   # secret
AI_BUDGET_MENSUEL_EUROS=
