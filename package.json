{
  "name": "app-masterbac",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verif": "npm run lint && npm run typecheck && npm run test",
    "test:couverture": "vitest run --coverage",
    "tout": "npm run lint && npm run typecheck && npm run test:couverture && npm run contenu:verifier && npm run test:db && npm run build",
    "contenu:verifier": "vitest run --config vitest.contenu.config.mts",
    "db:demarrer": "PATH=\"$PATH:/Applications/Docker.app/Contents/Resources/bin:$HOME/.docker/bin\" supabase start",
    "db:arreter": "PATH=\"$PATH:/Applications/Docker.app/Contents/Resources/bin:$HOME/.docker/bin\" supabase stop",
    "db:reinitialiser": "PATH=\"$PATH:/Applications/Docker.app/Contents/Resources/bin:$HOME/.docker/bin\" supabase db reset",
    "db:types": "PATH=\"$PATH:/Applications/Docker.app/Contents/Resources/bin:$HOME/.docker/bin\" supabase gen types typescript --local --schema public > lib/serveur/supabase/types.ts",
    "test:db": "PATH=\"$PATH:/Applications/Docker.app/Contents/Resources/bin:$HOME/.docker/bin\" supabase test db",
    "env:local": "node scripts/env-local.mjs",
    "contenu:importer": "node --env-file=.env.local scripts/contenu-importer.mts",
    "admin:local": "node --env-file=.env.local scripts/admin-local.mjs",
    "db:migrer": "PATH=\"$PATH:/Applications/Docker.app/Contents/Resources/bin:$HOME/.docker/bin\" supabase migration up"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@vercel/analytics": "1.6.1",
    "katex": "0.19.1",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.10",
    "@types/katex": "0.16.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "fast-check": "4.10.2",
    "supabase": "2.122.1",
    "tailwindcss": "4.1.10",
    "typescript": "5.8.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
